.venv/
__pycache__/
*.pyc
jobs/*/media/
jobs/*/out/
jobs/*/calib/
.DS_Store
renders/*.mov
jobs/fns-2905408276/overlays/*.mov
jobs/fns-2905408276/overlays/*.wav
# `vendor/` was ignored wholesale, so NONE of the Remotion source has ever
# been committed — every component, the theme and the motion spec lived
# only on disk, and the commits that said they added them captured only the
# Python side. George: "I'd like this to be something that we continue
# working towards as like a foundation." A foundation is version-controlled.
# node_modules, the 19 MB base.mp4, the crops and the photos stay out.
vendor/*
!vendor/remotion-clip08/
vendor/remotion-clip08/*
!vendor/remotion-clip08/src/
!vendor/remotion-clip08/public/
!vendor/remotion-clip08/package.json
!vendor/remotion-clip08/tsconfig.json
!vendor/remotion-clip08/remotion.config.ts
renders/styles/*.mov
renders/styles/*.mp4
vendor/remotion-clip08/node_modules/
vendor/remotion-clip08/public/base.mp4
vendor/remotion-clip08/public/crop_*.png
jobs/fns-2905408276/overlays/rm_*.mov
jobs/fns-2905408276/photos/
vendor/remotion-clip08/public/p_*.jpg
# Real viewers' usernames and messages. Regenerable with `build_chat.py`,
# and third parties' words do not need to live in this repository.
# `src/Root.tsx` imports chat.json, so run build_chat.py before a render.
jobs/*/chat_*.json
vendor/remotion-clip08/public/chat.json
vendor/remotion-clip08/public/badges/
jobs/*/overlays_*/
jobs/*/retail/
web/factory.db
jobs/*/web/
web/.runner.lock
web/.site-key

# ─────────────────────────────────────────────────────────────────────────
# NOT IN THE REPOSITORY, AND ON PURPOSE.
#
# Rendered video is build OUTPUT — regenerable from a spec plus the source
# VOD — and it was 5 GB of the 5.1 GB pack. Fourteen blobs in the old
# history were over 100 MB, which GitHub rejects outright, so the history
# was rewritten to drop them. The files themselves are untouched on disk.
#
# `jobs/_service/` held the launchd logs, and the site key was printed into
# site.out.log at startup across restarts — the defect this file's own
# record describes. A service log is not source and must never be tracked.
*.mp4
*.mov
deliver/
jobs/_service/

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "edit.json \u2014 the clip edit decision list",
  "type": "object",
  "required": [
    "clip_id",
    "genre",
    "source",
    "range",
    "layout",
    "segments",
    "render"
  ],
  "additionalProperties": false,
  "properties": {
    "clip_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9_]+-[a-z0-9_-]+$"
    },
    "genre": {
      "enum": [
        "frag",
        "take",
        "receipts",
        "hybrid"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "owner",
        "rights_basis",
        "fps"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "rights_basis": {
          "enum": [
            "explicit",
            "affiliate",
            "client_owned"
          ]
        },
        "rights_proof": {
          "type": "string"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "precaptioned": {
          "type": "boolean"
        }
      }
    },
    "detection": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "event": {
          "enum": [
            "ace",
            "4k",
            "3k",
            "2k",
            "clutch",
            "flick",
            "defuse",
            "retake",
            "take",
            "reaction",
            "none"
          ]
        },
        "round_kills": {
          "type": "integer",
          "minimum": 0
        },
        "stakes": {
          "type": "array",
          "items": {
            "enum": [
              "spike_down",
              "match_point",
              "eco",
              "last_alive",
              "overtime",
              "thrifty",
              "none"
            ]
          }
        },
        "reaction_rms_peak": {
          "type": "number"
        },
        "chat_velocity_x": {
          "type": "number"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "speaker": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "flag": {
          "type": "string"
        },
        "host_stream": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "voices_in_window": {
          "type": "integer",
          "minimum": 0
        },
        "identified_by_appearance_only": {
          "type": "boolean"
        },
        "narrated_intro": {
          "type": "boolean"
        }
      }
    },
    "subject": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string"
        },
        "type": {
          "enum": [
            "player",
            "team",
            "map",
            "agent",
            "org",
            "event",
            "other"
          ]
        },
        "in_roster_json": {
          "type": "boolean"
        }
      }
    },
    "claim": {
      "type": "object",
      "properties": {
        "setup": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "min_lines_ok": {
          "type": "boolean"
        },
        "contiguous": {
          "type": "boolean"
        }
      }
    },
    "range": {
      "type": "object",
      "required": [
        "in",
        "out"
      ],
      "properties": {
        "in": {
          "type": "number",
          "minimum": 0
        },
        "out": {
          "type": "number",
          "minimum": 0
        },
        "anchor_rule": {
          "type": "string"
        }
      }
    },
    "hook": {
      "type": "object",
      "required": [
        "device"
      ],
      "properties": {
        "device": {
          "enum": [
            "cold_open",
            "flash_forward",
            "none"
          ]
        },
        "payoff_in": {
          "type": "number"
        },
        "length_frames": {
          "type": "integer",
          "minimum": 1
        },
        "black_frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "text": {
          "type": "string"
        },
        "seconds": {
          "type": "number"
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ]
        },
        "split_ratio": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.7
        },
        "facecam_source": {
          "type": "object",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          }
        },
        "facecam_detected": {
          "type": "boolean"
        },
        "facecam_frame_fraction": {
          "type": "number"
        },
        "facecam_sharpen": {
          "type": "boolean"
        },
        "crop": {
          "type": "object",
          "properties": {
            "anchor_x": {
              "type": "number"
            },
            "anchor_y": {
              "type": "number"
            }
          }
        },
        "hud_recomposite": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "element",
              "src",
              "dst"
            ],
            "properties": {
              "element": {
                "enum": [
                  "killfeed",
                  "spike_timer",
                  "minimap",
                  "abilities",
                  "scoreboard"
                ]
              },
              "src": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "dst": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "scale": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "in",
          "out",
          "speed"
        ],
        "properties": {
          "in": {
            "type": "number",
            "minimum": 0
          },
          "out": {
            "type": "number",
            "minimum": 0
          },
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ramp_frames": {
            "type": "integer",
            "minimum": 0
          },
          "punch": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 1.3
          },
          "reason": {
            "type": "string"
          },
          "cut_reason": {
            "type": "string"
          },
          "in_fight": {
            "type": "boolean"
          },
          "punch_to": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 1.6,
            "description": "Animate the punch from `punch` to this value across the segment."
          },
          "punch_ease": {
            "enum": [
              "linear",
              "in",
              "out",
              "in_out"
            ]
          }
        }
      }
    },
    "inserts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "in",
          "length",
          "asset"
        ],
        "properties": {
          "in": {
            "type": "number"
          },
          "length": {
            "type": "number",
            "minimum": 0.4,
            "maximum": 3.0
          },
          "asset": {
            "type": "string"
          },
          "push": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "covers_cut": {
            "type": "boolean"
          },
          "rights_basis": {
            "type": "string"
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "style": {
          "enum": [
            "phrase",
            "word"
          ]
        },
        "words_per_card": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "position_y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "in",
              "out",
              "text"
            ],
            "properties": {
              "in": {
                "type": "number"
              },
              "out": {
                "type": "number"
              },
              "text": {
                "type": "string"
              },
              "emphasis": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "target_lufs": {
          "type": "number"
        },
        "true_peak_dbtp": {
          "type": "number"
        },
        "measured_lufs": {
          "type": "number"
        },
        "duck": {
          "type": "object",
          "properties": {
            "amount_db": {
              "type": "number"
            },
            "attack_ms": {
              "type": "number"
            },
            "release_ms": {
              "type": "number"
            }
          }
        },
        "music": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "bed": {
              "type": "string"
            },
            "lufs": {
              "type": "number"
            },
            "rights_basis": {
              "type": "string"
            }
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "number"
              },
              "asset": {
                "type": "string"
              },
              "rights_basis": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "credit",
              "watermark",
              "hook",
              "label"
            ]
          },
          "text": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "position": {
            "enum": [
              "top-left",
              "top-right",
              "bottom-left",
              "bottom-right",
              "bottom-center",
              "top-center"
            ]
          },
          "size": {
            "type": "number"
          },
          "margin": {
            "type": "number"
          },
          "in": {
            "type": "number",
            "minimum": 0
          },
          "out": {
            "type": "number",
            "minimum": 0
          },
          "ease": {
            "enum": [
              "linear",
              "in",
              "out",
              "in_out"
            ]
          }
        }
      }
    },
    "tail_frames": {
      "type": "integer"
    },
    "qa": {
      "type": "object",
      "properties": {
        "first_frames_black": {
          "type": "boolean"
        },
        "first_frames_menu": {
          "type": "boolean"
        },
        "has_speech": {
          "type": "boolean"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "speech_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "held": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "render": {
      "type": "object",
      "required": [
        "backend",
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "backend": {
          "enum": [
            "ffmpeg",
            "fcpxml",
            "resolve_mcp"
          ]
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "fps": {
          "type": "number"
        },
        "codec": {
          "type": "string"
        },
        "audio_codec": {
          "type": "string"
        }
      }
    },
    "effects": {
      "description": "Frame-timed visual punctuation: shakes, flashes, glows, whips, zoom punches.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "shake",
              "flash",
              "glow",
              "whip_pan",
              "zoom_punch",
              "rgb_split"
            ]
          },
          "at": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "minimum": 0.02,
            "maximum": 2.0
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "0..1. Flashes are capped lower by the gate."
          },
          "ease": {
            "enum": [
              "linear",
              "in",
              "out",
              "in_out"
            ]
          },
          "motivation": {
            "type": "string",
            "description": "What in the footage this punctuates. Unmotivated effects are decoration."
          },
          "asset": {
            "type": "string"
          },
          "rights_basis": {
            "type": "string"
          }
        }
      }
    }
  }
}